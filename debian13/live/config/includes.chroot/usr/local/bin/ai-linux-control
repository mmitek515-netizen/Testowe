#!/usr/bin/env bash
# Desktop entry: inspect local server before opening; no auto-root execution.
set -Eeuo pipefail
url="http://127.0.0.1:3000"
if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 3 "$url/api/health" >/dev/null; then
  exec xdg-open "$url"
fi
message="Panel AI Linux jest wyłączony. Otwórz Konsole i uruchom: sudo ai-linux-start (po instalacji systemu; wymaga sieci, Dockera i miejsca na model)."
if command -v kdialog >/dev/null 2>&1; then
  kdialog --title "AI Linux" --msgbox "$message"
else
  printf '%s\n' "$message" >&2
fi
