# Copy to .env on your Debian 13 host. Never commit real keys.
# The Compose stack sets OLLAMA_BASE_URL=http://ollama:11434 internally.
# Do not use localhost from hosted Google AI Studio.
OLLAMA_MODEL=llama3.2-vision:11b
APP_PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For running the Node backend without Compose:
OLLAMA_BASE_URL=http://127.0.0.1:11434
PORT=3000
APP_URL=

# Optional internal local worker (bootstrap script generates a random secret).
# Do not paste this into the browser and do not commit a populated .env.
AGENT_API_TOKEN=

# Imported Debian 13 system runtime: generated by scripts/start-debian13-ollama-agents.sh
# Store only in .env (ignored by git), not in frontend code.
DEBIAN13_API_TOKEN=
# Optional overrides: by default the Debian runtime uses private Ollama.
# The Compose service passes a non-secret local placeholder to Ollama's API.
MODEL_CHAT_URL=
MODEL_API_KEY=
MODEL_NAME=
VISION_MODEL_NAME=
