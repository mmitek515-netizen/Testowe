# Copy to .env on your Debian 13 host. Never commit real keys.
# The Compose stack sets OLLAMA_BASE_URL=http://ollama:11434 internally.
# Do not use localhost from hosted Google AI Studio.
OLLAMA_MODEL=llama2-uncensored:7b
APP_PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For running the Node backend without Compose:
OLLAMA_BASE_URL=http://127.0.0.1:11434
PORT=3000
APP_URL=

# Optional internal local worker (bootstrap script generates a random secret).
# Do not paste this into the browser and do not commit a populated .env.
AGENT_API_TOKEN=
