# Gemini API key (set in AI Studio Secrets or on the server; never commit real keys)
GEMINI_API_KEY=
# Choose a model available to your Gemini API account
GEMINI_MODEL=gemini-2.5-flash
# Ollama runs on the backend host or an explicitly trusted server
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin3:8b
PORT=3000
# Optional deployment URL
APP_URL=
